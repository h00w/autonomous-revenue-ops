# Autonomous Revenue Ops runtime configuration
ARO_APP_NAME=Autonomous Revenue Ops
ARO_SERVICE_VERSION=0.4.0
ARO_ENVIRONMENT=development
ARO_API_PREFIX=/v1
ARO_LOG_LEVEL=INFO
ARO_IDEMPOTENCY_TTL_SECONDS=3600
ARO_WORKFLOW_STORE_BACKEND=memory

# HubSpot CRM — keep tokens in local environment / secret manager only
ARO_HUBSPOT_ACCESS_TOKEN=
ARO_HUBSPOT_BASE_URL=https://api.hubapi.com
ARO_HUBSPOT_CUSTOM_PROPERTIES=

# Salesforce CRM
ARO_SALESFORCE_INSTANCE_URL=
ARO_SALESFORCE_ACCESS_TOKEN=
ARO_SALESFORCE_API_ROOT=/services/data/latest
ARO_SALESFORCE_CUSTOM_FIELDS=

# Slack Incoming Webhook
ARO_SLACK_WEBHOOK_URL=

# SMTP email
ARO_SMTP_HOST=
ARO_SMTP_PORT=587
ARO_SMTP_USERNAME=
ARO_SMTP_PASSWORD=
ARO_SMTP_FROM_EMAIL=
ARO_SMTP_USE_STARTTLS=true

# AI providers. Configure one or more; routing order is explicit.
ARO_AI_PROVIDER_ORDER=openai,anthropic,gemini
ARO_AI_TIMEOUT_SECONDS=30
ARO_OPENAI_API_KEY=
ARO_OPENAI_BASE_URL=https://api.openai.com
ARO_OPENAI_MODEL=gpt-5.6-terra
ARO_ANTHROPIC_API_KEY=
ARO_ANTHROPIC_BASE_URL=https://api.anthropic.com
ARO_ANTHROPIC_MODEL=claude-sonnet-5
ARO_GEMINI_API_KEY=
ARO_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
ARO_GEMINI_MODEL=gemini-3.8-flash
