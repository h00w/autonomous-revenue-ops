{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus-compatible source containing Autonomous Revenue Ops metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {"title": "GitHub", "url": "https://github.com/h00w/autonomous-revenue-ops", "type": "link"},
    {"title": "Portfolio case study", "url": "https://hendarmawan.se/projects/autonomous-revenue-ops/", "type": "link"}
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Persisted workflow runs",
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "aro_workflow_runs", "legendFormat": "runs"}],
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Completion ratio",
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "aro_workflow_completion_ratio", "legendFormat": "completion"}],
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 0}
    },
    {
      "type": "stat",
      "title": "Failure ratio",
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "aro_workflow_failure_ratio", "legendFormat": "failure"}],
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 0}
    },
    {
      "type": "stat",
      "title": "Human review ratio",
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "aro_workflow_human_review_ratio", "legendFormat": "human review"}],
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 0}
    },
    {
      "type": "stat",
      "title": "Authorization ratio",
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "aro_workflow_authorization_ratio", "legendFormat": "authorized"}],
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 0}
    },
    {
      "type": "stat",
      "title": "Execution receipt ratio",
      "id": 6,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "aro_execution_receipt_ratio", "legendFormat": "receipt"}],
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Workflow states",
      "id": 7,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "aro_workflow_status", "legendFormat": "{{status}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}
    },
    {
      "type": "timeseries",
      "title": "Policy decisions",
      "id": 8,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "aro_policy_decision", "legendFormat": "{{decision}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}
    },
    {
      "type": "timeseries",
      "title": "Recorded workflow lifecycle",
      "id": 9,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "aro_workflow_lifecycle_seconds_avg", "legendFormat": "average"},
        {"refId": "B", "expr": "aro_workflow_lifecycle_seconds_p95", "legendFormat": "p95"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}
    },
    {
      "type": "timeseries",
      "title": "Recovery and additional-research ratios",
      "id": 10,
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "aro_workflow_recovery_ratio", "legendFormat": "recovery"},
        {"refId": "B", "expr": "aro_workflow_research_more_ratio", "legendFormat": "research more"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}
    },
    {
      "type": "text",
      "title": "Evidence boundary",
      "id": 11,
      "options": {
        "mode": "markdown",
        "content": "This dashboard visualizes aggregate `measured_runtime` telemetry from persisted workflow state. It does **not** establish customer ROI, model accuracy, or long-window SLO attainment by itself."
      },
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 21}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["autonomous-revenue-ops", "production-ai", "revops", "agentic-ai"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Autonomous Revenue Ops · Operations Overview",
  "uid": "aro-ops-overview",
  "version": 1
}
